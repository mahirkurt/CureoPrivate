# OS / editör
.DS_Store
Thumbs.db
.idea/
.vscode/
# Gizli anahtarlar — ASLA commit edilmez
.env
.env.*
.dev.vars
*.token
*.secret
# Geçici
*.log
node_modules/

# Python bytecode
__pycache__/
*.pyc

# evidentia secret keys doc — holds LIVE MCP API keys; NEVER commit (gitignored everywhere)
EVIDENTIA-KURULUM-VE-KEYLER.md
*-KEYLER.md
plugins/evidentia/docs/EVIDENTIA-KURULUM-VE-KEYLER.md

# Üretilen claude.ai skill paketleri (build script ile yeniden üretilir)
plugins/*/dist/

# Kök /shared/ — PLUGIN İÇERİĞİ DEĞİL, koşum çıktısı iniş alanı.
# Plugin'lerin paylaşılan sözleşmeleri plugins/<ad>/shared/ altında yaşar ve İZLENİR.
# Depo kökündeki /shared/ yalnızca bir ajanın çıplak "shared/..." yolunu CWD'ye çözüp
# buraya yazmasıyla oluşur (2026-08-07 denetimi: vekayinuvis hook metni bu şekilde
# 2026-07-09 tarihli bir araştırma çıktısını buraya düşürmüştü; kök neden hook'ta
# ${CLAUDE_PLUGIN_ROOT} kullanılarak giderildi). Buradaki içerik plugin kataloğuna
# ait değildir — kendi yerine taşıyın, commit ETMEYİN.
/shared/

# Yerel workspace meta verisi — CureoHub'ın .gitignore'u ile simetrik.
# `.claude/settings.json` `permissions.additionalDirectories` kablolamasını taşır;
# izin ayarları bilinçli olarak git'e KONMAZ (repo erişimi olan herkesin izin
# yüzeyini değiştirebilmesi demek olurdu). 2026-09-11'de ölçüldü: CureoHub bunu
# ignore ediyordu, bu repo ise ne ignore ne track ediyordu — yani `git clean -fd`
# dosyayı sessizce silerdi.
.claude/
*.code-workspace
