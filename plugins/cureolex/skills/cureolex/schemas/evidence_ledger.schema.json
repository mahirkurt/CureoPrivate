{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cureolex.local/schemas/evidence_ledger.schema.json",
  "title": "Cureolex Evidence Ledger / EDR (v1.0)",
  "description": "Kanıt Defteri (Evidence Decision Record — EDR). Cureolex çıktısındaki HER somut bilimsel/hukuki iddianın denetlenebilir kaydı: kaynak, GRADE, doğrulama bayrağı, hangi çıktı bölümünü desteklediği ve Vancouver atfı. R14'teki 'EDR tüketim noktaları' kavramını biçimselleştirir; evidence_grading + citation_index + turkish_legislation_refs alanlarından türetilir. Amaç: G5 (içtihat/doktrin temeli) + G7 (epistemik dürüstlük) kapılarının makine-denetlenebilir kanıtını üretmek.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_version", "generated_at", "source_sidecar", "entries"],
  "properties": {
    "ledger_version": { "type": "string", "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_sidecar": {
      "description": "Bu defterin türetildiği sidecar künyesi.",
      "type": "object",
      "required": ["schema_version", "cureolex_version"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "string", "enum": ["2.0", "2.3", "2.3.1"] },
        "medical_research_version": { "type": "string" },
        "cureolex_version": { "type": "string", "pattern": "^[2-9]\\.[0-9]+(\\.[0-9]+)?$" }
      }
    },
    "mode": {
      "description": "Defteri üreten cureolex modu.",
      "type": "string",
      "enum": ["DRAFT", "AMEND", "ANALYZE", "COMPLY", "OPINE", "RIA", "COMPARATIVE_LAW", "PARLIAMENTARY_BILL", "TBMM_KANUN_TEKLIFI", "EX_POST_EVALUATION", "REGULATORY_MATURITY", "TRANSPOSITION", "RELIANCE_FRAMEWORK"]
    },
    "home_jurisdiction": { "type": "string", "pattern": "^(?:[A-Z]{2}(?:-[A-Z0-9]{1,3})?|ORG:[A-Z][A-Z0-9-]{1,15}|INTL|WHO)$", "description": "G11 (4.0): çıktının yazıldığı yargı bölgesi = aktif paket. ISO 3166-1 alfa-2 · ISO 3166-2 alt birim (DE-BY) · ORG:<ad> ulusüstü örgüt (ORG:WHO; ORG:AU = Afrika Birliği, AU = Avustralya) · INTL. 4.0 öncesi 'WHO'/'UK' eski takma ad olarak kabul edilir; yeni çıktı 'ORG:WHO'/'GB' yazar. Bkz. jurisdictions/_schema/supranational_codes.yaml." },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ledgerEntry" }
    },
    "integrity_summary": {
      "description": "Defter düzeyinde G7 özeti. unverified_count > 0 ise çıktıda bilgi-sınırı uyarısı zorunludur.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_entries": { "type": "integer", "minimum": 0 },
        "verified_count": { "type": "integer", "minimum": 0 },
        "unverified_count": { "type": "integer", "minimum": 0 },
        "illustrative_placeholder_count": { "type": "integer", "minimum": 0 },
        "high_grade_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_text", "claim_type", "source", "verification", "supports_sections"],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^E[0-9]{3,}$",
          "description": "Benzersiz kanıt kimliği, örn. E001."
        },
        "claim_text": { "type": "string", "minLength": 1 },
        "claim_type": {
          "type": "string",
          "enum": ["clinical_evidence", "regulatory_fact", "legislation_ref", "case_law", "doctrine", "international_norm", "hta_economic", "market_data"]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "identifier"],
          "properties": {
            "category": {
              "type": "string",
              "enum": ["primary_legislation", "case_law", "international_acquis", "scientific_literature", "regulatory_authority", "hta_body", "real_world_data"]
            },
            "identifier": {
              "type": "string",
              "description": "NCT/PMID/CELEX/RG-no/E.-K. no/DOI gibi kararlı tanımlayıcı."
            },
            "title": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "registry_id": {
              "description": "source_registry.yaml'daki kaynak kimliğine bağ (örn. 'tr.law.1262').",
              "type": "string"
            }
          }
        },
        "grade": {
          "description": "Klinik iddialar için GRADE; hukuki iddialar için n/a olabilir.",
          "type": "string",
          "enum": ["HIGH", "MODERATE", "LOW", "VERY_LOW", "n/a"]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mcp_verified", "status"],
          "properties": {
            "mcp_verified": { "type": "boolean" },
            "verifier": {
              "type": "string",
              "enum": ["mevzuat_mcp", "mevzuat_bilgisi_mcp", "yargi_mcp", "yoktez_mcp", "titck_mcp", "health_policy_mcp", "german_law_mcp", "fedlex_swiss_companion", "open_primary_source", "medical_research_connector", "eurlex_mcp", "fedlex_mcp", "uk_legal_mcp", "intl_treaty_mcp", "resmi_gazete_mcp", "none"]
            },
            "status": {
              "type": "string",
              "enum": ["verified", "unverified", "illustrative_placeholder_not_verified"]
            },
            "verified_at": { "type": "string", "format": "date-time" }
          },
          "if": { "properties": { "mcp_verified": { "const": false } } },
          "then": {
            "properties": { "status": { "enum": ["unverified", "illustrative_placeholder_not_verified"] } }
          }
        },
        "supports_sections": {
          "description": "Bu kanıtın desteklediği çıktı bölümleri (örn. ['§2 Bilimsel Dayanak', 'Madde 3 gerekçesi']).",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "citation_vancouver": { "type": "string" },
        "jurisdiction": { "type": "string", "pattern": "^(?:[A-Z]{2}(?:-[A-Z0-9]{1,3})?|ORG:[A-Z][A-Z0-9-]{1,15}|INTL|WHO)$", "description": "G11 (4.0): kanıtın AİT OLDUĞU yargı bölgesi. Verilirse jurisdiction_role zorunludur; home_jurisdiction ile karşılaştırma tests/validate_packs.py ve G11 kapısınındır." },
        "jurisdiction_role": {
          "description": "G11 (4.0): kaynağın bu çıktıdaki hukuki rolü. binding yalnız home_jurisdiction'ın kendi normu ya da orada doğrudan uygulanan norm için; treaty_obligation onayı intl-treaty ile doğrulanmış andlaşma için. Yabancı norm ulusal norm gibi sunulamaz.",
          "type": "string",
          "enum": ["binding", "transposition_source", "comparative_benchmark", "persuasive", "treaty_obligation"]
        },
        "as_of_date": { "type": "string", "description": "G10 (4.0): iddianın dayandığı yürürlük tarihi (ISO-8601)." },
        "in_force_status": {
          "description": "G10 (4.0): as_of_date itibarıyla hükmün durumu. repealed bir hüküm yürürlükteki dayanak olarak kullanılamaz.",
          "type": "string",
          "enum": ["in_force", "repealed", "amended_since", "not_yet_in_force", "unknown"]
        }
      },
      "if": { "required": ["jurisdiction"] },
      "then": { "required": ["jurisdiction_role"] },
      "$comment": "G7 zinciri: status='verified' YALNIZCA mcp_verified=true ile geçerlidir; aksi halde çıktı bu iddiayı 'doğrulanmamış/temsilî' olarak etiketlemelidir."
    }
  }
}
