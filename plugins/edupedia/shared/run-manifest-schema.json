{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cureonics.com/edupedia/run-manifest-schema-v2.json",
  "x-schema-version": "2.0.0",
  "x-revised": "2026-08-17",
  "title": "edupedia Run Manifest v2",
  "description": "edupedia koşum kaydı: istek kapsamı, tek-sefer connector defteri, kanonik artefaktlar, Tier-2 durumu, yerel validator'ın 16 kapısı ve güvenli göreli HTML teslim yolu. Manifest, HTML ile aynı dizinde aynı ad + '.manifest.json' uzantısıyla tutulur. Normatif: canonical-cache-contract.md + validate_module.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "ts",
    "plugin_version",
    "requested_scope",
    "connector_call_ledger",
    "single_shot_enforced",
    "canonical_artifacts",
    "tier2_status",
    "deliverable_path"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^Edupedia-\\d{8}-[a-z0-9]+(?:-[a-z0-9]+)*-v\\d+$",
      "description": "NORMATİF KALIP (verbatim): Edupedia-YYYYMMDD-<ders>-<konu>-v<N> — ör. Edupedia-20260706-fen5-hucre-v1. <ders> ve <konu> yalnız küçük harf/rakam/tire (ör. 'fen5', 'hucre'); <N> pozitif tamsayı sürüm numarası. Bu kalıba UYMAYAN bir run_id yazma."
    },
    "ts": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "format": "date-time"
    },
    "plugin_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "plugin.json version (ör. 0.1.0)"
    },
    "requested_scope": {
      "type": "object",
      "description": "Kullanıcı girdisi kapsamı.",
      "additionalProperties": false,
      "required": [
        "command",
        "mode"
      ],
      "properties": {
        "command": {
          "enum": [
            "modul",
            "mufredat",
            "soru",
            "kazanim-bul",
            "durum",
            "direct-skill"
          ]
        },
        "mode": {
          "enum": [
            "MODULE",
            "QUIZ",
            "FLASHCARDS",
            "GAME",
            "EXPLAINER",
            "ASSESSMENT",
            "SERIES",
            "CURRICULUM",
            "EXAM"
          ]
        },
        "outcome_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "subject_slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "grade": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "soru"
              }
            },
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "mode": {
                "const": "EXAM"
              }
            },
            "required": [
              "mode"
            ]
          }
        }
      ]
    },
    "connector_call_ledger": {
      "type": "array",
      "description": "Her Maarif MCP çağrısı — çift-sorgu yasağı denetimi (canonical-cache-contract.md §6).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "args_summary",
          "cache"
        ],
        "properties": {
          "tool": {
            "enum": [
              "server_info",
              "list_education_levels",
              "list_subjects",
              "get_subject",
              "list_curriculum_programs",
              "get_curriculum_program",
              "list_learning_outcomes",
              "search_learning_outcomes",
              "search",
              "list_frameworks",
              "get_framework",
              "list_document_kinds",
              "list_documents",
              "get_document_text",
              "list_textbooks",
              "list_guides",
              "list_reports",
              "list_videos",
              "get_video",
              "search_figures",
              "get_figure"
            ]
          },
          "args_summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "cache": {
            "enum": [
              "hit",
              "miss"
            ]
          }
        }
      }
    },
    "single_shot_enforced": {
      "type": "boolean",
      "const": true,
      "description": "Her (tool, scope) çifti en fazla bir kez cache:miss olabilir; teslim manifestinde değer zorunlu olarak true'dur."
    },
    "canonical_artifacts": {
      "type": "object",
      "description": "Kanonik artefakt önbelleği — tek-sefer çıkarım kanıtı.",
      "additionalProperties": false,
      "properties": {
        "subject_registry": {
          "allOf": [
            {
              "$ref": "#/definitions/artifact"
            },
            {
              "properties": {
                "scope_hash": {
                  "pattern": "^subject_registry:[0-9a-f]{12}$"
                }
              }
            }
          ]
        },
        "outcomes_extract": {
          "allOf": [
            {
              "$ref": "#/definitions/artifact"
            },
            {
              "properties": {
                "scope_hash": {
                  "pattern": "^outcomes_extract:[0-9a-f]{12}$"
                }
              }
            }
          ]
        },
        "framework_map": {
          "allOf": [
            {
              "$ref": "#/definitions/artifact"
            },
            {
              "properties": {
                "scope_hash": {
                  "pattern": "^framework_map:[0-9a-f]{12}$"
                }
              }
            }
          ]
        },
        "figure_probe": {
          "allOf": [
            {
              "$ref": "#/definitions/artifact"
            },
            {
              "properties": {
                "scope_hash": {
                  "pattern": "^figure_probe:[0-9a-f]{12}$"
                }
              }
            }
          ]
        }
      }
    },
    "tier2_status": {
      "enum": [
        "unavailable",
        "degraded",
        "embedded"
      ],
      "description": "get_figure yetenek-probu sonucu (CONNECTORS.md §3.1). unavailable=araç yok; degraded=include_image=true başarısız/atlandı, Tier-1'de kalındı; embedded=resmî görsel gömüldü."
    },
    "tier2_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Serbest metin: ör. 'tier2_degraded: 413_payload_too_large' veya 'tier2_unavailable: tool_absent'."
    },
    "quality_gates": {
      "type": "object",
      "description": "scripts/validate_module.py --json çıktısının birebir yerel doğrulama kaydı. Alan yazılırsa 16 kapının tamamı bulunmalıdır.",
      "additionalProperties": false,
      "required": [
        "G-EMOJI",
        "G-CARBON",
        "G-A11Y",
        "G-INTERACT",
        "G-SELFCONTAINED",
        "G-CONTRAST",
        "G-SVG",
        "G-WELLBEING",
        "G-VOICE",
        "G-AUDIO",
        "G-CURRICULUM",
        "G-VERIFY",
        "G-TOKEN",
        "G-FLOW",
        "G-CARBON-GRID",
        "G-EXAM"
      ],
      "properties": {
        "G-EMOJI": {
          "$ref": "#/definitions/gate"
        },
        "G-CARBON": {
          "$ref": "#/definitions/gate"
        },
        "G-A11Y": {
          "$ref": "#/definitions/gate"
        },
        "G-INTERACT": {
          "$ref": "#/definitions/gate"
        },
        "G-SELFCONTAINED": {
          "$ref": "#/definitions/gate"
        },
        "G-CONTRAST": {
          "$ref": "#/definitions/gate"
        },
        "G-SVG": {
          "$ref": "#/definitions/gate"
        },
        "G-WELLBEING": {
          "$ref": "#/definitions/gate"
        },
        "G-VOICE": {
          "$ref": "#/definitions/gate"
        },
        "G-AUDIO": {
          "$ref": "#/definitions/gate"
        },
        "G-CURRICULUM": {
          "$ref": "#/definitions/gate"
        },
        "G-VERIFY": {
          "$ref": "#/definitions/gate"
        },
        "G-TOKEN": {
          "$ref": "#/definitions/gate"
        },
        "G-FLOW": {
          "$ref": "#/definitions/gate"
        },
        "G-CARBON-GRID": {
          "$ref": "#/definitions/gate"
        },
        "G-EXAM": {
          "$ref": "#/definitions/gate"
        }
      }
    },
    "deliverable_path": {
      "type": "string",
      "pattern": "^(?!.*[\\u0000-\\u001F])(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+\\.html$",
      "description": "Üretilen tek-dosya HTML modülünün güvenli göreli yolu; mutlak yol, URI, ters eğik çizgi ve '..' geçişi yasaktır."
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "metadata": {
      "type": "object",
      "description": "İstemciye özgü, çekirdek sözleşmeyi değiştirmeyen açık uzantı alanı.",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier2_status": {
            "enum": [
              "unavailable",
              "degraded"
            ]
          }
        },
        "required": [
          "tier2_status"
        ]
      },
      "then": {
        "required": [
          "tier2_note"
        ]
      }
    }
  ],
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_hash",
        "status"
      ],
      "properties": {
        "scope_hash": {
          "type": "string",
          "pattern": "^(?:subject_registry|outcomes_extract|framework_map|figure_probe):[0-9a-f]{12}$",
          "description": "<artifact_type>:<sha256(scope)[:12]>"
        },
        "status": {
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "caveat": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "degraded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "caveat"
            ]
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "WARN",
            "SKIPPED"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
