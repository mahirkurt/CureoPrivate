{
  // anamnesis-mcp — Cloudflare Worker (Cureonics Family A). Deploy: `wrangler deploy`.
  //
  // PROVISIONING (run BEFORE first deploy — see BUILD-BRIEF.md S2):
  //   npx wrangler vectorize create anamnesis-index --dimensions=1024 --metric=cosine
  //   npx wrangler d1 create anamnesis-graph           # paste database_id below
  //
  // SECRETS ARE NOT DECLARED HERE (auth invariant 6). Set them with:
  //   wrangler secret put MCP_API_KEY
  //   wrangler secret put AUTH_HMAC_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anamnesis-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI — embeddings (@cf/baai/bge-m3, 1024-d). Available as env.AI.
  "ai": { "binding": "AI" },

  // Vectorize — chunk vector store. index_name MUST match the created index (1024-d cosine).
  // Metadata indexes (required for collection/doc_id filter; create on HP BEFORE relying on
  // live Vectorize filters — D1 post-filter is the isolation source of truth either way):
  //   npx wrangler vectorize create-metadata-index anamnesis-index --property-name=collection --type=string
  //   npx wrangler vectorize create-metadata-index anamnesis-index --property-name=doc_id --type=string
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "anamnesis-index" }
  ],

  // D1 — chunk/doc text store + entity-relation graph. Paste database_id after `d1 create`.
  "d1_databases": [
    { "binding": "DB", "database_name": "anamnesis-graph", "database_id": "64c547b8-934d-42ef-aee1-01e83f512d0f" }
  ],

  // Legacy DO binding kept for migration history. /mcp is stateless (createMcpHandler);
  // class exported as empty shell so a stray wake cannot hit free-tier SQL write cap.
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "Anamnesis" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Anamnesis"] }
  ],

  // NON-SECRET vars only. OAUTH_ALLOWED_REDIRECT_ORIGINS empty => default allowlist
  // (see DEFAULT_ALLOWED_ORIGINS in src/auth.ts). Loopback (127.0.0.1/localhost/::1,
  // any port — VS Code/Codex CLI/native OAuth) and cursor:// are allowed unconditionally
  // in code regardless of this var. MCP_ALLOW_NO_AUTH MUST stay "0" in production.
  //
  // STRICT_COLLECTION: tenancy transition switch (audit 2026-09-07, findings B1-B3). "0" keeps
  // today's behaviour and merely LOGS every unscoped call as an `anamnesis.scope_violation` line;
  // "1" turns those into errors (unscoped ingest / search / forget / upsert_triples). Flip it
  // only once the logs are clean for all four plugins, the two sibling MCP servers
  // (marmara, openathens) and the thesis scripts — evidence first, breakage second.
  "vars": {
    "MCP_ALLOW_NO_AUTH": "0",
    "STRICT_COLLECTION": "0",
    "OAUTH_ALLOWED_REDIRECT_ORIGINS": "https://claude.ai,https://claude.com,https://grok.com,https://chatgpt.com,https://oauth-redirect.googleusercontent.com,https://vscode.dev,https://insiders.vscode.dev,https://cursor.com,https://www.cursor.com"
  },

  // Nightly TTL reaper (audit finding A2). Expired scratch used to accumulate forever in D1 AND
  // in Vectorize, where dead vectors stole candidate-pool slots from live results. 04:10 UTC.
  "triggers": { "crons": ["10 4 * * *"] },

  "observability": { "enabled": true }
}
