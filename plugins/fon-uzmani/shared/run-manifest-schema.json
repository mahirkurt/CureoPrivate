{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cureonics.com/schemas/fon-uzmani/run-manifest.json",
  "title": "Fon Uzmanı — Orkestrasyon Çalışma Kaydı (run manifest)",
  "description": "Her orkestratör çalışması için üretilen denetlenebilir kayıt. Skill çağrıları, kalite kapıları, üretilen/önbelleklenen artefaktlar ve connector çağrı defteri. Karar-destek; SPK yatırım danışmanlığı değildir.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "mode", "brief_snapshot", "skill_invocations", "quality_gates", "artifacts"],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^TFA-[0-9]{8}-(YAT|EMK|MIX)-M[1-5]-v[0-9]+$",
      "description": "TFA-YYYYMMDD-(YAT|EMK|MIX)-(M1-5)-vN"
    },
    "mode": { "type": "integer", "minimum": 1, "maximum": 5 },
    "started_at": { "type": "string" },
    "brief_snapshot": { "type": "object" },
    "skill_invocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "phase"],
        "properties": {
          "skill": {
            "enum": ["fon-analiz-orkestratoru", "fon-haritalama", "quant-analiz",
                     "piyasa-makro", "regulasyon-uyum", "portfoy-insa", "izleme"]
          },
          "phase": { "type": "string", "pattern": "^G[0-7](\\.[0-9]+)?$" },
          "timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "result"],
        "properties": {
          "gate": { "type": "string", "pattern": "^G[0-7](\\.[0-9]+)?$" },
          "result": { "enum": ["PASS", "WARN", "BLOCK"] },
          "controls_passed": { "type": ["integer", "null"] },
          "controls_total": { "type": ["integer", "null"] },
          "detail": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "cached_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "scope_hash"],
        "properties": {
          "type": {
            "enum": ["fund_registry", "holdings", "nav_series", "market_context",
                     "peer_metrics", "quant_metrics", "optimized_portfolio"]
          },
          "scope_hash": { "type": "string" },
          "fetched_at_phase": { "type": ["string", "null"] },
          "reused_at_phases": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": ["string", "null"] }
        }
      }
    },
    "connector_call_ledger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fon_mcp": {
          "type": "object",
          "properties": {
            "calls": { "type": "integer" },
            "single_shot_enforced": { "type": "boolean" }
          }
        },
        "borsa_mcp": {
          "type": "object",
          "properties": {
            "fund_data_calls": { "type": "integer" },
            "index_calls": { "type": "integer" },
            "macro_calls": { "type": "integer" }
          }
        },
        "quant_engine": {
          "type": "object",
          "properties": {
            "scripts_run": { "type": "integer" },
            "deterministic": { "type": "boolean" }
          }
        }
      }
    },
    "caveats": { "type": "array", "items": { "type": "string" } }
  }
}
