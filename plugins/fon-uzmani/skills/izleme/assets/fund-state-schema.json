{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cureonics.com/schemas/fon-uzmani/fund-state.json",
  "title": "Fon Uzmanı — Fon izleme durum anlık görüntüsü",
  "description": "Mod 5 (izleme) için fon-bazlı durum snapshot'ı. fund_monitor.py change_points iki snapshot'ı bu şemaya göre karşılaştırır. NAV/metrik alanları gün-sonu (EOD). Karar-destek; SPK yatırım danışmanlığı değildir.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_at", "funds"],
  "properties": {
    "generated_at": { "type": "string", "description": "ISO 8601" },
    "basis": { "type": "string", "default": "EOD/gün-sonu, gecikmeli olabilir" },
    "funds": { "type": "array", "items": { "$ref": "#/$defs/fundState" } }
  },
  "$defs": {
    "fundState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fund_id"],
      "properties": {
        "fund_id": { "type": "string", "description": "TEFAS fon kodu (örn. AFA, TI2)" },
        "universe": { "enum": ["YAT", "EMK", null] },
        "category": { "type": ["string", "null"] },
        "last_nav": { "type": ["number", "null"] },
        "as_of": { "type": ["string", "null"] },
        "aum": { "type": ["number", "null"] },
        "ter": { "type": ["number", "null"] },
        "quant_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sharpe": { "type": ["number", "null"] },
            "sortino": { "type": ["number", "null"] },
            "max_drawdown": { "type": ["number", "null"] },
            "volatility": { "type": ["number", "null"] },
            "beta": { "type": ["number", "null"] }
          }
        },
        "style_fingerprint": {
          "type": ["object", "null"],
          "description": "Stil-sapma tespiti için holdings/faktör profili (önceki snapshot'la karşılaştırılır)."
        },
        "regime_tag": { "enum": ["Risk-Açık", "Nötr", "Risk-Kapalı", null] },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["rejim_degisimi", "stil_sapmasi", "drawdown_esigi", "vol_sicramasi", "ter_artisi", "kap_duyurusu", "yeni_eklendi"] },
              "severity": { "enum": ["Yüksek", "Orta", "Düşük", null] },
              "detail": { "type": ["string", "null"] },
              "date": { "type": ["string", "null"] }
            }
          }
        },
        "open_kap": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "date": { "type": ["string", "null"] },
              "title": { "type": "string" },
              "materiality_tier": { "enum": ["Yüksek", "Orta", "Düşük", null] }
            }
          }
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
