{
  "description": "historia-medicinae runtime enforcement — (1) SessionStart filo preflight + üç tuzak + bağlam ekonomisi; (2) SessionStart/UserPromptSubmit Anamnesis münhasır collection `histmed:run:<12hex>` + `hmrun:` önek; SessionEnd yalnız o collection'ı forget eder (Stop'ta silmez); (3) PreToolUse kapsamsız hybrid_query/graph/search DENY, scoped ALLOW; (4) PostToolUse retrieve-don't-dump + ingest ledger; (5) Stop G0 coverage + anachronism_guard. Fail-open. Disable: <project>/.claude/histmed-anamnesis.off",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_guard.py\"",
            "timeout": 10,
            "statusMessage": "historia-medicinae: anamnesis kapsam kapısı"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py\"",
            "timeout": 15,
            "statusMessage": "historia-medicinae: filo preflight + tarihsel akıl yürütme konvansiyonları"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_lifecycle.py\"",
            "timeout": 25,
            "statusMessage": "historia-medicinae: anamnesis münhasır çalışma seti"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_lifecycle.py\"",
            "timeout": 25,
            "statusMessage": "historia-medicinae: anamnesis koşu kapsamı"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_lifecycle.py\"",
            "timeout": 25,
            "statusMessage": "historia-medicinae: anamnesis çalışma setini temizle"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/retrieve_dont_dump.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*anamnesis.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_ledger.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop_coverage.py\"",
            "timeout": 15,
            "statusMessage": "historia-medicinae: G0 kapsam manifestosu kontrolü"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anachronism_guard.py\"",
            "timeout": 15,
            "statusMessage": "historia-medicinae: anakronizm ve retro-tanı taraması"
          }
        ]
      }
    ]
  }
}
