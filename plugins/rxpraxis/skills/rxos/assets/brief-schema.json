{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cureonics.com/rxpraxis/brief-schema.json",
  "title": "rxos Aşama 0 Brief",
  "description": "Kullanıcının doğal dil briefinin deterministic JSON karşılığı. G0 kalite kapısı bu şemaya karşı validate eder.",
  "type": "object",
  "required": ["therapeutic_area", "target_indications", "primary_authorities", "target_launch_year", "max_development_months", "min_global_sales_usd", "max_complexity", "exclusion_categories"],
  "properties": {
    "therapeutic_area": {
      "type": "string",
      "description": "≥1 ICD-10 prefix ile eşleştirilmiş TA (DERM/ONKO/HEME/IMMUN/CARDIO/METAB/NEURO/RESP/INFEKT/GI/RENAL/MUSCULO/OPHTH/PSYCH/ENDO). Hiçbiri varsayılan değil."
    },
    "target_indications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["icd10", "snomed", "treatment_line"],
        "properties": {
          "icd10": {"type": "string"},
          "snomed": {"type": "string", "description": "SNOMED CT code — G0 zorunlu"},
          "treatment_line": {"type": "string"}
        }
      }
    },
    "primary_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["FDA", "EMA", "MHRA", "PMDA", "TGA", "HC", "Swissmedic"]}
    },
    "secondary_authorities": {"type": "array", "items": {"type": "string"}},
    "target_launch_year": {
      "type": "integer",
      "description": "≥ current_year + 3 önerilir (G0 kontrolü)"
    },
    "max_development_months": {"type": "integer", "default": 36},
    "min_global_sales_usd": {"type": "number", "default": 50000000},
    "max_complexity": {"enum": ["LOW", "MEDIUM", "HIGH", "VERY_HIGH"]},
    "exclusion_categories": {
      "type": "array",
      "description": "Yalnız uygulanabilir olanlar aktive edilir (boş olabilir).",
      "items": {
        "enum": [
          "biologics_de_novo",
          "gene_therapy",
          "ATMP",
          "cold_chain",
          "controlled_substances",
          "systemic_JAK",
          "radiopharmaceutical",
          "blood_products"
        ]
      }
    },
    "ta_calibration": {
      "type": "object",
      "description": "§0.C TA-adaptasyon çıktısı (G0.8 WARN).",
      "properties": {
        "epi_anchor": {"type": "string", "description": "onkoloji→GLOBOCAN/IARC; aksi→IHME GBD + registry + WHO GHO"},
        "guideline_authorities": {"type": "array", "items": {"type": "string"}},
        "funnel_defaults": {"type": "object"}
      }
    }
  }
}
