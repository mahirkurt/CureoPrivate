{
  "description": "vekayinuvis runtime enforcement — altı invaryant: (1) SessionStart connector-preflight + konvansiyonlar (fail-open); (2) SessionStart/UserPromptSubmit Anamnesis münhasır collection `vekayinuvis:run:<12hex>` + `vkrun:` önek; SessionEnd yalnız o collection'ı forget eder (Stop'ta silmez); (3) PreToolUse kapsamsız hybrid_query/graph/search DENY, scoped ALLOW; (4) PostToolUse retrieve-don't-dump + ingest ledger; (5) devarsiv_degrade re-login runbook; (6) Stop G0 coverage + citation_discipline. Fail-open. Disable anamnesis guard: <project>/.claude/vekayinuvis-anamnesis.off",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_guard.py\"",
            "timeout": 10,
            "statusMessage": "vekayinuvis: anamnesis kapsam kapısı"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py\"",
            "timeout": 15,
            "statusMessage": "vekayinuvis: tam-filo preflight + bağlam-ekonomisi konvansiyonları"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_lifecycle.py\"",
            "timeout": 25,
            "statusMessage": "vekayinuvis: anamnesis münhasır çalışma seti"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_lifecycle.py\"",
            "timeout": 25,
            "statusMessage": "vekayinuvis: anamnesis koşu kapsamı"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_lifecycle.py\"",
            "timeout": 25,
            "statusMessage": "vekayinuvis: anamnesis çalışma setini temizle"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/retrieve_dont_dump.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*anamnesis.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/anamnesis_ledger.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.*devarsiv.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/devarsiv_degrade.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "_comment": "PostToolUseFailure kurulu Claude Code sürümünde tanınmayabilir — bilinmeyen event kaydı zararsızca yoksayılır; tanındığında devarsiv_* araç HATALARINDA da re-login runbook'u tetiklenir (PostToolUse ile aynı script/matcher).",
        "matcher": "^mcp__.*devarsiv.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/devarsiv_degrade.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop_coverage.py\"",
            "timeout": 15,
            "statusMessage": "vekayinuvis: tam-filo G0 kapsam manifestosu kontrolü"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/citation_discipline.py\"",
            "timeout": 15,
            "statusMessage": "vekayinuvis: arşiv atıf-disiplini kontrolü"
          }
        ]
      }
    ]
  }
}
